#!/usr/bin/env bash
# Run mostudio with API keys from Bitwarden Secrets Manager, through MoOS (`moos secrets run`).
# MoOS reads the access token from the Keychain item bws-<project>, forces the right Bitwarden
# server and passes the command to `bws run`. Keys exist only in the child process.
#
#   mostudio-bws <mostudio args...>   run a mostudio command
#   mostudio-bws --check              list which provider keys are available (names only)
#
# Settings (all optional):
#   MOSTUDIO_BWS_PROJECT   MoOS secrets project (default: hermes → Keychain item bws-hermes)
#   MOOS_BIN               path to moos when it isn't on PATH
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cli="$here/mostudio.ts"
project="${MOSTUDIO_BWS_PROJECT:-hermes}"

moos="${MOOS_BIN:-$(command -v moos 2>/dev/null || true)}"
[ -n "$moos" ] || moos="/Volumes/1TBT705CRUCIAL/mo-projects/agentic-moos/bin/moos"
[ -x "$moos" ] || { echo "mostudio-bws: moos not found; set MOOS_BIN or use mostudio with .env.local" >&2; exit 1; }

if [ "${1:-}" = "--check" ]; then
  # Prints provider key names and whether each is set; never values.
  exec "$moos" secrets run "$project" -- node -e "
    const p = require('$root/providers.json');
    const names = [...new Set(p.flatMap(e => e.keyEnv ? [e.keyEnv] : []))].sort();
    for (const n of names) console.log((process.env[n] ? 'set     ' : 'missing ') + n);
  "
fi

exec "$moos" secrets run "$project" -- node "$cli" "$@"
