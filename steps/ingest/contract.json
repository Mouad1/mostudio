{
  "name": "ingest",
  "version": "3",
  "inputs": [],
  "outputs": ["media/ingest.json"],
  "params": { "source": "string" },
  "fileParams": ["source"],
  "gate": [
    { "metric": "hasAudio", "op": "==", "value": true, "level": "fail" },
    { "metric": "durationSec", "op": ">", "value": 0, "level": "fail" }
  ]
}
