{
  "name": "qa",
  "version": "1",
  "inputs": ["renders/final.mp4"],
  "outputs": ["renders/contact-sheet.jpg", "renders/qa.md"],
  "params": {},
  "private": true,
  "gate": [
    { "metric": "hasAudio", "op": "==", "value": true, "level": "fail" },
    { "metric": "blackStartSec", "op": "<=", "value": 0.1, "level": "fail" },
    { "metric": "silentStartSec", "op": "<=", "value": 0.5, "level": "fail" },
    { "metric": "integratedLufs", "op": "between", "value": [-15, -13], "level": "warn" }
  ]
}
