{
  "name": "transcribe",
  "version": "5",
  "inputs": ["media/ingest.json"],
  "outputs": ["transcript/audio.wav", "transcript/words.json"],
  "params": { "language": "string?", "prefer": "string?", "dialect": "string?", "prompt": "string?" },
  "private": true,
  "gate": [
    { "metric": "pctTimestamped", "op": ">=", "value": 95, "level": "fail" },
    { "metric": "meanConfidence", "op": ">=", "value": 0.7, "level": "warn" },
    { "metric": "wordCount", "op": ">", "value": 0, "level": "fail" }
  ]
}
