  "segments": [
    {
      "start": 0,
      "end": 3.64,
      "text": " السلام أصدقاء أخيراً درت الفيديو الأول"
    },
    {
      "start": 3.64,
      "end": 5.58,
      "text": " ستاري الأولى"
    },
    {
      "start": 5.58,
      "end": 11.16,
      "text": " الأوبجيكتيف ديال هاد الاشيان هو باش نبارتاجي معاكم"
    },
    {
      "start": 11.16,
      "end": 14.3,
      "text": " للي ميور بخاتيك ديال الآي"
    },
    {
      "start": 14.3,
      "end": 17.42,
      "text": " كنعرف بزاف ديال الناس اللي كيختموا الآي"
    },
    {
      "start": 17.42,
      "end": 20.82,
      "text": " ولي بلزو ما ما كيقدروش"
    },
    {
      "start": 20.82,
      "end": 24.64,
      "text": " يمزوروا لفالو غشو تديرهم"
    },
    {
      "start": 24.64,
      "end": 27.26,
      "text": " برابر لشنو كي يتعهم الآي"
    },
    {
      "start": 27.26,
      "end": 29.92,
      "text": " وهذا ما سنشاركه معكم"
    },
    {
      "start": 29.92,
      "end": 31.82,
      "text": " أحد أهم الأشياء التي سنحاول"
    },
    {
      "start": 31.82,
      "end": 33.94,
      "text": " أن نتحدث عنها"
    },
    {
      "start": 33.94,
      "end": 34.92,
      "text": " أو نشاركها"
    },
    {
      "start": 34.92,
      "end": 37.04,
      "text": " في هذا الشأن"
    },
    {
      "start": 37.04,
      "end": 39.3,
      "text": " سنحاول أن نعمل على"
    },
    {
      "start": 39.3,
      "end": 41.16,
      "text": " مشروعات مباشرة"
    },
    {
      "start": 41.16,
      "end": 43.08,
      "text": " أكثر"
    },
    {
      "start": 43.08,
      "end": 45.14,
      "text": " أو نشارك معكم"
    },
    {
      "start": 45.14,
      "end": 45.84,
      "text": " أسلوب"
    },
    {
      "start": 45.84,
      "end": 49.22,
      "text": " مهنية ومتنقلة"
    },
    {
      "start": 49.22,
      "end": 49.96,
      "text": " وما إلى ذلك"
    },
    {
      "start": 49.96,
      "end": 52,
      "text": " إذاً"
    },
    {
      "start": 52,
      "end": 54.32,
      "text": " نراكم قريبا"
    },
    {
      "start": 54.32,
      "end": 55.76,
      "text": " في الفيديو الأول"
    },
    {
      "start": 57.26,
      "end": 68,
      "text": " مش مشكل"
    }
  ]
}