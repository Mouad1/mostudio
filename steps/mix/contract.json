{
  "name": "mix",
  "version": "2",
  "inputs": ["media/ingest.json", "cut/edl.json"],
  "outputs": ["audio/mix.wav"],
  "params": { "music": "string?", "musicDb": "number?", "targetLufs": "number?" },
  "fileParams": ["music"],
  "private": true,
  "gate": [
    { "metric": "integratedLufs", "op": "between", "value": [-15, -13], "level": "fail" },
    { "metric": "driftSec", "op": "<=", "value": 0.02, "level": "fail" },
    { "metric": "truePeakDb", "op": "<=", "value": -1, "level": "fail" }
  ]
}
